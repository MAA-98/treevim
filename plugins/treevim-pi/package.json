{
  "name": "treevim-pi",
  "version": "0.1.0-beta.1",
  "type": "module",
  "keywords": [
    "pi-package",
    "treevim"
  ],
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/treevim.js"
    ]
  },
  "scripts": {
