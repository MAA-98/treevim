{
  "name": "treevim",
  "version": "0.1.0-beta.2",
  "description": "A standalone Vim-inspired tree editor in the terminal.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "bin": {
    "treevim": "./dist/cli.js"
  },
  "types": "./dist/api/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api/index.d.ts",
      "default": "./dist/api/index.js"
    },
    "./app": {
      "types": "./dist/api/app/index.d.ts",
      "default": "./dist/api/app/index.js"
    },
    "./config": {
      "types": "./dist/api/treevim-api/index.d.ts",
      "default": "./dist/api/treevim-api/index.js"
    },
    "./treevim": {
      "types": "./dist/api/treevim.d.ts",
      "default": "./dist/api/treevim.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MAA-98/treevim.git"
  },
  "bugs": {
    "url": "https://github.com/MAA-98/treevim/issues"
  },
  "homepage": "https://github.com/MAA-98/treevim#readme",
  "publishConfig": {
    "tag": "beta"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "ink": "^7.1.1",
    "react": "^19.0.0",
    "slice-ansi": "^9.0.1",
    "wrap-ansi": "^10.0.2",
    "zod": "^4.4.3"
  }
}
